{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SwaggerEndPoints": [
    {
      "Key": "shifttrack-api",
      "Config": [
        {
          "Name": "ShiftTrack API",
          "Version": "1.0",
          "Url": "http://shifttrack-api:8080/swagger/v1/swagger.json"
        }
      ]
    }
  ],

  "Routes": [
    {
      "DownstreamPathTemplate": "/hubs/shift-track/{everything}",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [
        {
          "Host": "shifttrack.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/hubs/shift-track/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ]
    },
    {
      "SwaggerKey": "shifttrack-api",
      "DownstreamPathTemplate": "/api/shift-track/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "shifttrack.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/shift-track/{everything}",
      "UpstreamHttpMethod": [ "POST", "PUT", "GET", "DELETE" ]
    }
  ]
}
